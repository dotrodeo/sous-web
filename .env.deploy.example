# Per-environment deploy config. Copy to .env.dev and .env.prod (one each), fill
# in, then deploy:
#   npm run deploy dev        # or: docker compose --env-file .env.dev up -d --build
#   npm run deploy prod
# These files are gitignored. VITE_* are BUILD-TIME (baked into the static
# bundle) — rebuild to change them.

# Selects the stack (container/network/image names get this suffix).
ENV=dev

# Baked into the bundle (both non-secret). Point VITE_API_BASE_URL at THIS
# environment's PUBLIC soupi API URL — the browser calls it directly, so it must
# be the tunnel hostname, not an internal container name.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_API_BASE_URL=https://api-dev.example.com

# localhost-only host port for smoke tests; use a distinct port per env on one
# host (e.g. sous-web dev 8082 / prod 8083; soupi uses 8080 / 8081).
WEB_PORT=8082

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel).
# Ingress should point at http://sous_web_${ENV}_app:80
TUNNEL_TOKEN=
